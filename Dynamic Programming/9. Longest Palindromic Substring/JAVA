// https://leetcode.com/problems/longest-palindromic-substring

// Recursion TLE

class Solution {
    private String res = "";  
    private boolean helper(int i, int j, String s) {
        boolean isPal = false;
        if (i == j) {
            isPal = true;
        } 
        else if (s.charAt(i) == s.charAt(j) && 
                (j == i + 1 || helper(i + 1, j - 1, s))) {
            isPal = true;
        }
        if (isPal) {
            // update longest palindrome
            if (j - i + 1 > res.length()) {
                res = s.substring(i, j + 1);  // end index is exclusive in Java
            }
        } 
        else {
            helper(i + 1, j, s);
            helper(i, j - 1, s);
        }
        return isPal;
    }
    public String longestPalindrome(String s) {
        res = "";
        helper(0, s.length() - 1, s);
        return res;
    }
}


// Bottom Up DP

class Solution {

    public String longestPalindrome(String s) {
        int n = s.length();
        boolean[][] dp = new boolean[n][n];
        String res = "";

        for(int l = 1; l<=n ; l++) {
            for(int i = 0; i<= n-l; i++) {
                int j = i+l-1;
                if(i == j) dp[i][j] = true;
                else if(s.charAt(i) == s.charAt(j) && (j == i+1 || dp[i+1][j-1]))
                    dp[i][j] = true;
                else dp[i][j] = false;
                if(dp[i][j]) res = s.substring(i, j+1);
            }
        }
        return res;
    }
    
}
